# Arquivos de sistema operacional
# Ignora arquivos de metadados do macOS e Windows.
.DS_Store
Thumbs.db

# Dependências
# A pasta node_modules é instalada dinamicamente via npm install.
/node_modules
/.pnp
.pnp.js

# Arquivos de log e debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Arquivos de ambiente e segredos
# Contêm segredos e chaves locais. NUNCA devem ser versionados.
.env*.local
.env
*.pem

# Diretórios de build, compilação e distribuição
/dist
/build
/.next/
/out

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testes e cobertura de código
coverage/

# Rascunhos de estudo e notas locais de trabalho
docs/drafts/
