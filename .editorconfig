# https://editorconfig.org
root = true

# Padrão global para todos os arquivos
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Exceção para arquivos Markdown:
# No Markdown, dois espaços no final de uma linha criam uma quebra de linha (<br>).
[*.md]
trim_trailing_whitespace = false
