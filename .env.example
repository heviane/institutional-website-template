# Exemplo de variáveis de ambiente do projeto
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mails Transacionais (Resend)
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL="Contato <contato@empresa.com.br>"
CONTACT_EMAIL_TO=contato@empresa.com.br

# Proteção Anti-Spam (Cloudflare Turnstile)
# Defina NEXT_PUBLIC_ENABLE_TURNSTILE=false para desligar instantaneamente (modo Lite)
NEXT_PUBLIC_ENABLE_TURNSTILE=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rate Limiting & Anonimização LGPD (HMAC-SHA256)
# Obrigatório em produção (mínimo 16 caracteres, ex: openssl rand -hex 16)
# Em dev/test possui fallback automático se omitido
RATE_LIMIT_SECRET=

# Rate Limiting Distribuído em Produção Serverless (Upstash Redis)
# Opcional com ativação progressiva: se omitido, utiliza Map nativo em memória com TTL
# Se configurado, AMBAS as variáveis abaixo são estritamente obrigatórias
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Gestão de Conteúdo (Keystatic CMS)
# Modo Keystatic Cloud (Padrão recomendado em produção conforme ADR 0006)
NEXT_PUBLIC_KEYSTATIC_PROJECT=

# Modo GitHub App / Self-hosted (Opcional - necessário apenas caso utilize GitHub App próprio em vez do Keystatic Cloud)
KEYSTATIC_SECRET=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
