# Exemplo de variáveis de ambiente do projeto
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mails Transacionais (Resend)
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL="Contato <contato@empresa.com.br>"
CONTACT_EMAIL_TO=contato@empresa.com.br

# Proteção Anti-Spam (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Gestão de Conteúdo (Keystatic - Modo GitHub App / Self-hosted)
# Preenchimento necessário apenas se optar pelo modo GitHub nativo em vez do Keystatic Cloud
KEYSTATIC_SECRET=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
